{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bashka-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Videos need byte-range (206) responses, which only the Worker provides.
    "run_worker_first": ["/images/portfolio-slike/*"]
  }
}
